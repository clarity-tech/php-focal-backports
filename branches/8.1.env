# PHP 8.1. Plain KEY=value only: sourced by config.env (also from the Makefile, by /bin/sh), with
# PHP_SOURCE=php8.1 already set.

# The PPA's signed jammy upload, rebuilt unchanged.
#   8.1.34-9 carries 0083-Avoid-state-corruption-via-bailout.patch, the PPA's backport of the
#   PHP2Shell fix (CVE-2026-109618, CVE-2026-109619). PHP 8.1 is past upstream's end of life.
PHP_SOURCE_VERSION=8.1.34-9+ubuntu22.04.1+deb.sury.org+1
# The first package version that carries the fix. scripts/test.sh fails a build below it, and
# host/install.sh refuses one. host/install.sh keeps its own copy, so that a bundle cannot vouch
# for itself; scripts/test.sh checks the two agree.
FIX_FLOOR=8.1.34-9
# The upstream release that fixed it, which PHP_VERSION must reach. Empty for a branch past
# upstream's end of life: the fix is the PPA's backported patch, and PHP_VERSION stays put.
FIX_UPSTREAM=

# The libgd that targets/focal.env builds this branch against. The PPA's last focal build of
# php8.1, 8.1.32-1 (arm64, https://launchpad.net/~ondrej/+archive/ubuntu/php/+build/30419448), used
# its focal libgd 2.3.3-12.
FOCAL_LIBGD=2.3.3-12+ubuntu20.04.1+deb.sury.org+1

# The extension packages scripts/test.sh installs, besides the SAPIs: a typical Laravel web node's.
PHP_EXTENSIONS="bcmath curl gd gmp intl mbstring mysql opcache readline sqlite3 xml zip"

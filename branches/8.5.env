# PHP 8.5. Plain KEY=value only: sourced by config.env (also from the Makefile, by /bin/sh), with
# PHP_SOURCE=php8.5 already set.

# The PPA's signed jammy upload, rebuilt unchanged.
#   8.5.12 is the upstream release with the PHP2Shell fix (CVE-2026-109618, CVE-2026-109619).
#   OPcache is built into PHP 8.5, so there is no php8.5-opcache package. Focal's ICU is 66, so
#   IntlListFormatter supports TYPE_AND and WIDTH_WIDE only: TYPE_OR, TYPE_UNITS, WIDTH_SHORT and
#   WIDTH_NARROW need ICU >= 67.
PHP_SOURCE_VERSION=8.5.12-1+ubuntu22.04.1+deb.sury.org+1
# The first package version that carries the fix. scripts/test.sh fails a build below it, and
# host/install.sh refuses one. host/install.sh keeps its own copy, so that a bundle cannot vouch
# for itself; scripts/test.sh checks the two agree.
FIX_FLOOR=8.5.12-1
# The upstream release that fixed it, which PHP_VERSION must reach. Empty for a branch past
# upstream's end of life: the fix is the PPA's backported patch, and PHP_VERSION stays put.
FIX_UPSTREAM=8.5.12

# The libgd that targets/focal.env builds this branch against. TRIAL ONLY: the PPA never built
# php8.5 for focal, so there is no build log to match. This takes the newest libgd the PPA built for
# focal, 2.3.3-13, as 8.3 and 8.4 did. CI builds and tests it but never releases it.
FOCAL_LIBGD=2.3.3-13+ubuntu22.04.1+deb.sury.org+1@jammy

# The extension packages scripts/test.sh installs, besides the SAPIs: a typical Laravel web node's.
PHP_EXTENSIONS="bcmath curl gd gmp intl mbstring mysql readline sqlite3 xml zip"

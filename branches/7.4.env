# PHP 7.4. Plain KEY=value only: sourced by config.env (also from the Makefile, by /bin/sh), with
# PHP_SOURCE=php7.4 already set.

# The PPA's signed jammy upload, rebuilt unchanged.
#   1:7.4.33-36 is the PPA's backport of the 2026-11-19 PHP security release (8.2.36) to this
#   branch, which is past upstream's end of life; 1:7.4.33-37 only moves the upstream test suite to
#   autopkgtest. Both keep the earlier PHP2Shell fix (CVE-2026-109618, CVE-2026-109619).
PHP_SOURCE_VERSION=1:7.4.33-37+ubuntu22.04.1+deb.sury.org+1
# The first package version that carries the fixes. scripts/test.sh fails a build below it, and
# host/install.sh refuses one. host/install.sh keeps its own copy, so that a bundle cannot vouch
# for itself; scripts/test.sh checks the two agree.
FIX_FLOOR=1:7.4.33-36
# The upstream release that fixed it, which PHP_VERSION must reach. Empty for a branch past
# upstream's end of life: the fix is the PPA's backported patch, and PHP_VERSION stays put.
FIX_UPSTREAM=

# The libgd that targets/focal.env builds this branch against. The PPA's last focal build of
# php7.4, 1:7.4.33-20 (arm64, https://launchpad.net/~ondrej/+archive/ubuntu/php/+build/30700598), used
# its focal libgd 2.3.3-13. That upload's files are gone from Launchpad; it was a no-change backport
# of the same Debian source as the jammy upload, which is still published, so this rebuilds the
# jammy one (@jammy).
FOCAL_LIBGD=2.3.3-13+ubuntu22.04.1+deb.sury.org+1@jammy

# The extension packages scripts/test.sh installs, besides the SAPIs: a typical Laravel web node's.
PHP_EXTENSIONS="bcmath curl gd gmp intl json mbstring mysql opcache readline sqlite3 xml zip"

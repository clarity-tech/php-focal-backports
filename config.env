# What to rebuild, and for which target. Sourced by every script and by the Makefile, so plain
# KEY=value only, apart from the target selection below.

# Source: Ondřej Surý's Launchpad PPA. Each source upload (.dsc) is signed with his "Automated PPA
# Upload Key", which is registered to his Launchpad account (https://api.launchpad.net/1.0/~ondrej/gpg_keys).
# The public key is committed in keys/ and must match this fingerprint. (The PPA's archive key,
# B8DC7E53946656EFBCE4C1DD71DAEAAB4AD4CAB6, signs the repository indexes, not the uploads.)
PPA_OWNER=ondrej
PPA_NAME=php
UPLOAD_KEY_FPR=6A1AAD7AE5B401C6E259A7B257067BAA1314C7FC

# The series whose upload we take the source from. The PPA's packaging for every series is the
# same Debian source with a "No-change backport" changelog entry, so the jammy upload rebuilds
# unchanged on every target. (The PPA publishes only jammy and noble; it has no focal or resolute.)
SOURCE_SERIES=jammy

# Space-separated `source=exact PPA version` pairs, pinned so a build is reproducible. The same
# pairs for every target.
#   php8.1        8.1.34-9 carries 0083-Avoid-state-corruption-via-bailout.patch, the PHP2Shell
#                 fix (CVE-2026-109618, CVE-2026-109619)
#   php-defaults  provides php-common, which php8.1-* need at >= 1:81~. Focal's own archive has
#                 1:75. Resolute's own, 2:99ubuntu1, is new enough but declares Breaks:
#                 php8.1-common, so it cannot be used there either. Ours also installs
#                 /usr/lib/php/php-common.mk before php8.1 builds; php8.1's debian/rules includes
#                 it, and it switches on the packaging's version-check DNS telemetry (to
#                 telemetry.sury.org, from php-fpm and mod_php). Ubuntu's php-common has no such
#                 file, so building against it would give different binaries from focal's.
SOURCES="php8.1=8.1.34-9+ubuntu22.04.1+deb.sury.org+1 php-defaults=101~+ubuntu22.04.1+deb.sury.org+1"

# Target. TARGET names a file in targets/ that sets TARGET_SERIES, TARGET_VERSION and
# TEST_PACKAGES: focal (the default) or resolute. `make ... TARGET=resolute`, or
# `TARGET=resolute scripts/<step>.sh`.
TARGET=${TARGET:-focal}
. "${ROOT:-.}/targets/$TARGET.env"

# Our version suffix: <revision>+ubuntu<TARGET_VERSION>.1~<LOCAL_TAG>. The `~` never comes straight
# after the Debian revision, so the result always compares >= the revision it rebuilds (a fix-floor
# check such as "php8.1-common >= 8.1.34-9" passes). Against other builds of the same revision:
#   - the PPA's own format (8.1.34-9+ubuntu20.04.1+deb.sury.org+1): ours sorts BELOW it (`~` < `+`),
#     so 8.1.34-9+ubuntu20.04.1~backport1 upgrades a focal host's 8.1.28-2+ubuntu20.04.1+deb.sury.org+1
#     but would lose to an official focal build of 8.1.34-9;
#   - packages.sury.org's format (8.1.34-9+0~20261021.82+ubuntu26.04~1.gbp4e430a): ours sorts ABOVE
#     it (`u` > `0`), so on resolute apt prefers ours to sury's 8.1.34-9 at equal pin priority. Any
#     later revision (8.1.34-10...) still wins.
# Bump it for every new build of the same revision: builds are not byte-reproducible, and
# scripts/upload.sh refuses to replace a published bundle.
LOCAL_TAG=${LOCAL_TAG:-backport1}

# sury's packaging patch 0048 (2026-02-11) adds a DNS "version check" to php-fpm and mod_php: at
# startup each sends an encrypted UDP/53 query with the package name and version to
# telemetry.sury.org. php8.1's debian/rules marks it "not enabled in build by default" and turns it
# on only when /usr/lib/php/php-common.mk, shipped by php-common, defines TELEMETRY_HOST. `off`
# empties that file inside the build container before php8.1 is built, which compiles the call out.
# No source is changed. scripts/test.sh fails a build whose php-fpm8.1 still names the host.
SURY_TELEMETRY=off
# Goes into the rebuilt packages' changelog entry. Placeholder address: set your own.
MAINTAINER=${MAINTAINER:-"PHP backports <backports@example.invalid>"}

# Upload target (scripts/upload.sh). Hosts fetch through pre-signed URLs, so the bucket stays
# private and no instance role needs access to it.
# Set these for your account; nothing is uploaded without them.
S3_BUCKET=${S3_BUCKET:-}
S3_PREFIX=php-backports
# `-`, not `:-`: CI sets AWS_PROFILE_NAME to empty so the CLI uses the OIDC web identity, and that
# empty value must survive this file being sourced. Unset or empty means the CLI's default chain.
AWS_PROFILE_NAME=${AWS_PROFILE_NAME-}
AWS_REGION_NAME=${AWS_REGION_NAME:-}

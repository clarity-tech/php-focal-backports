# Ubuntu 26.04, for images that install PHP from packages.sury.org resolute. On 2026-10-22 that
# suite's arm64 index still served the pre-fix 8.1.34-8 while amd64 had 8.1.34-9; by 2026-10-24
# both had 8.1.34-9 (see README.md for why the target stays). The PPA builds only jammy and noble,
# so this rebuilds the same jammy upload as focal, unchanged.
# Plain KEY=value only: sourced by config.env, after branches/<branch>.env.
TARGET_SERIES=resolute
TARGET_VERSION=26.04
# 8.1 as before, plus 8.2 and 8.3 for arm64: on 2026-10-24 packages.sury.org's resolute arm64 index
# still served pre-fix 8.2.34 and 8.3.35 while amd64 had 8.2.35 and 8.3.36. CI builds those two
# for arm64 only (.github/workflows/release.yml).
TARGET_BRANCHES="8.1 8.2 8.3"

# What scripts/test.sh installs on a clean system, besides the branch's PHP_EXTENSIONS: the
# packages a typical web image installs, mod_php, their dependencies (common, readline), and php-common.
# php-common has to be ours: Ubuntu 26.04's own (2:99ubuntu1) declares Breaks: php8.1-common, so it
# cannot stand in for it.
TEST_PACKAGES="php-common $PHP_SOURCE $PHP_SOURCE-cli $PHP_SOURCE-common $PHP_SOURCE-fpm libapache2-mod-$PHP_SOURCE"

# Libraries to rebuild before PHP (see targets/focal.env). None: resolute's own are current.
LIB_SOURCES=""

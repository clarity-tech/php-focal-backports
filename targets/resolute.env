# Ubuntu 26.04, for images that install PHP from packages.sury.org resolute. On
# 2026-10-22 that suite's arm64 index still served the pre-fix 8.1.34-8 while amd64 had 8.1.34-9.
# The PPA builds only jammy and noble, so this rebuilds the same jammy upload as focal, unchanged.
# Plain KEY=value only: sourced by config.env.
TARGET_SERIES=resolute
TARGET_VERSION=26.04

# What scripts/test.sh installs on a clean system: the php8.1 packages a typical web image installs,
# their php8.1 dependencies (common, opcache, readline), and php-common. php-common has to be ours:
# Ubuntu 26.04's own (2:99ubuntu1) declares Breaks: php8.1-common, so it cannot stand in for it.
TEST_PACKAGES="php-common php8.1 php8.1-cli php8.1-common php8.1-fpm php8.1-bcmath php8.1-curl php8.1-gd
      php8.1-gmp php8.1-intl php8.1-mbstring php8.1-mysql php8.1-opcache php8.1-readline php8.1-sqlite3
      php8.1-xml php8.1-zip"

# Libraries to rebuild before php8.1 (see targets/focal.env). None: resolute's own are current.
LIB_SOURCES=""

# Ubuntu 20.04, for hosts that ran the PPA's PHP before it dropped focal. The PPA stopped building
# focal in 2025 (its last focal builds of every branch were deleted 2025-06-09); packages.sury.org
# has no focal suite at all. Plain KEY=value only: sourced by config.env, after branches/<branch>.env.
TARGET_SERIES=focal
TARGET_VERSION=20.04
# Every branch the PPA fixed. 8.5 is a trial: the PPA never built it for focal.
TARGET_BRANCHES="7.4 8.0 8.1 8.2 8.3 8.4 8.5"

# Libraries PHP is compiled against. The PPA did not build its focal PHP against plain focal: the
# build logs of its final focal uploads (arm64, on Launchpad; branches/<branch>.env links each one)
# show its own focal builds of these in the build environment. Compiling against focal's instead
# changes PHP itself:
#   libzip   focal ships libzip5 1.5.1 (libzip.so.5); the hosts have the PPA's libzip4 1.7.3
#            (libzip.so.4), so php8.1-zip needed a library apt will not add, and ZipArchive lost methods
#   libgd2   focal's 2.2.5 has no AVIF functions; the PPA's GD 2.3.3 exposes them. The version
#            differs by branch (FOCAL_LIBGD): 2.3.3-12 for 8.0, 8.1 and 8.2; 2.3.3-13 for 7.4, 8.3
#            and 8.4 (and the 8.5 trial). -13 drops libraqm.
#   pcre2    PHP sets PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK only when compiled against >= 10.38 headers;
#            without it, the hosts' runtime pcre2 (10.39, 10.40) rejects \K inside a lookaround
#   libxml2  LIBXML_VERSION is compiled in (20914 in the PPA's builds)
#   argon2   the version password_hash(PASSWORD_ARGON2*) was built with
#   libzstd, libidn2, pcre3
#            not PHP's own dependencies, but the PPA's builds of them replaced focal's in the
#            build chroot (libzstd1 1.4.8, libidn2-0 2.3.0 and libpcre3 8.45, at sbuild's
#            initial upgrade) and libpcre3-dev 8.45 came in with the build dependencies. Built
#            first, so the libraries after them build against them too.
# Each is the PPA's own focal upload, verified against the same upload key, rebuilt unchanged. They
# are deleted from the PPA but still downloadable from Launchpad. The exception is libgd2 2.3.3-13:
# its focal upload's files are gone, so the jammy upload of the same Debian source stands in
# (@jammy; see branches/7.4.env). build.sh builds them arch-only, as Launchpad's arm64 builders
# did, and installs them in the build container before PHP. They ship in the bundle for
# scripts/test.sh only: host/install.sh upgrades PHP packages and nothing else, so each host keeps
# its own libraries, which are the same versions or newer.
#
# Not rebuilt: the PPA's apache2 2.4.63, apr 1.7.2, apr-util 1.6.3 and brotli 1.1.0, from
# ppa:ondrej/apache2, whose focal files are all gone. mod_php is built against focal's own
# apache2-dev 2.4.41 instead; its module API (20120211) is the same across 2.4.
LIB_SERIES=focal
LIB_SOURCES="libzstd=1.4.8+dfsg-2+ubuntu20.04.1+deb.sury.org+4 libidn2=2.3.0-1+ubuntu20.04.1+deb.sury.org+2
      pcre3=2:8.45-1+ubuntu20.04.1+deb.sury.org+1 pcre2=10.42-3+ubuntu20.04.1+deb.sury.org+1
      argon2=0~20190702-0.1+ubuntu20.04.1+deb.sury.org+1 libxml2=2.9.14+dfsg-0.1+ubuntu20.04.1+deb.sury.org+1
      libzip=1.7.3-1+ubuntu20.04.1+deb.sury.org+2 libgd2=$FOCAL_LIBGD"

# What scripts/test.sh installs on a clean system, besides the branch's PHP_EXTENSIONS: the SAPIs
# a typical Laravel web node runs, php-common, and the libraries above that a PPA-built host has
# from the PPA rather than from focal.
TEST_PACKAGES="php-common $PHP_SOURCE-cli $PHP_SOURCE-common $PHP_SOURCE-fpm
      libargon2-1 libpcre2-8-0 libxml2 libzip4 libgd3 libzstd1 libidn2-0 libpcre3"

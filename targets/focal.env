# Ubuntu 20.04, for hosts that ran the PPA's php8.1 before it dropped focal. The PPA stopped building
# focal in 2025 (its last php8.1 for focal, 8.1.32, was deleted 2025-06-09); packages.sury.org has no
# focal suite at all. Plain KEY=value only: sourced by config.env.
TARGET_SERIES=focal
TARGET_VERSION=20.04

# Libraries php8.1 is compiled against. The PPA built its focal php8.1 (8.1.28-2 and 8.1.29-1)
# against its own builds of these, not focal's, according to those builds' logs on
# Launchpad. Compiling against focal's instead changes PHP itself:
#   libzip   focal ships libzip5 1.5.1 (libzip.so.5); the hosts have the PPA's libzip4 1.7.3
#            (libzip.so.4), so php8.1-zip needed a library apt will not add, and ZipArchive lost methods
#   libgd2   focal's 2.2.5 has no AVIF functions; the PPA's GD 2.3.3 exposes them
#   pcre2    PHP sets PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK only when compiled against >= 10.38 headers;
#            without it, the hosts' runtime pcre2 (10.39, 10.40) rejects \K inside a lookaround
#   libxml2  LIBXML_VERSION is compiled in (20914 in the PPA's builds)
#   argon2   the version password_hash(PASSWORD_ARGON2*) was built with
# Each is the PPA's own focal upload, verified against the same upload key, rebuilt unchanged. They
# are deleted from the PPA but still downloadable from Launchpad. build.sh installs them in the
# build container before php8.1. They ship in the bundle for scripts/test.sh only: host/install.sh
# upgrades php8.1 packages and nothing else, so each host keeps its own libraries, which are the
# same versions or newer.
LIB_SERIES=focal
LIB_SOURCES="argon2=0~20190702-0.1+ubuntu20.04.1+deb.sury.org+1 pcre2=10.42-3+ubuntu20.04.1+deb.sury.org+1
      libxml2=2.9.14+dfsg-0.1+ubuntu20.04.1+deb.sury.org+1 libzip=1.7.3-1+ubuntu20.04.1+deb.sury.org+2
      libgd2=2.3.3-9+ubuntu20.04.1+deb.sury.org+1"

# What scripts/test.sh installs on a clean system: a typical Laravel web node's php8.1 packages,
# php-common, and the libraries above that a PPA-built host has from the PPA rather than from focal.
TEST_PACKAGES="php-common php8.1-cli php8.1-common php8.1-fpm php8.1-bcmath php8.1-curl php8.1-gd php8.1-gmp
      php8.1-intl php8.1-mbstring php8.1-mysql php8.1-opcache php8.1-readline php8.1-sqlite3
      php8.1-xml php8.1-zip libargon2-1 libpcre2-8-0 libxml2 libzip4 libgd3"
